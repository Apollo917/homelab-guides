# Required

# The URL at which Vaultwarden is accessible — used internally by the service for constructing links
# (e.g. vault.example.com)
VAULTWARDEN_SERVICE_URL=<VAULTWARDEN_SERVICE_URL>

# Optional

# The public-facing URL of the Vaultwarden instance — used in emails and the web vault (e.g. https://vault.example.com)
DOMAIN=<DOMAIN>

# Log verbosity level — controls how much detail is written to the log (trace, debug, info, warn, error)
LOG_LEVEL=warn

# Path to the log file where Vaultwarden writes its output
LOG_FILE=data/logs/logs.log

# Path and base filename for the RSA key pair used for signing tokens
RSA_KEY_FILENAME=data/rsa/key

# Connection string for the database — defaults to SQLite; can be changed to MySQL or PostgreSQL
DATABASE_URL=data/db/db.sqlite3

# Whether new users can register accounts on their own — set to false to restrict access
SIGNUPS_ALLOWED=false

# Whether new users must verify their email address before their account is activated
SIGNUPS_VERIFY=false

# Comma-separated list of email addresses allowed to create organizations — leave empty to allow all users
ORG_CREATION_USERS=<EMAIL_1>,<EMAIL_2>

# Whether existing users can invite others to join the instance
INVITATIONS_ALLOWED=true

# The organization name shown in invitation emails sent to new users
INVITATION_ORG_NAME=<INVITATION_ORG_NAME>

# Whether users can grant emergency access to trusted contacts
EMERGENCY_ACCESS_ALLOWED=false

# Whether users are allowed to change their email address
EMAIL_CHANGE_ALLOWED=false

# Whether users can request a password hint — disable to reduce phishing risk
SHOW_PASSWORD_HINT=false
