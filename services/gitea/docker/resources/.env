# Required

# The URL at which Gitea is accessible, without protocol (e.g. gitea.example.com)
SERVICE_URL=<SERVICE_URL>

# The system user ID under which Gitea will run — run `id -u` to get the current user's ID
UID=<UID>

# The system group ID under which Gitea will run — run `id -g` to get the current user's group ID
GID=<GID>

# The host port mapped to the container's SSH port — must not conflict with the host's SSH port (22)
SSH_PORT=<SSH_PORT>

# Database type — supported values: mysql, postgres, sqlite3
DB_TYPE=postgres

# Database host address
DB_HOST=<DB_HOST>

# Database port
DB_PORT=<DB_PORT>

# Database name
DB_NAME=<DB_NAME>

# Database user
DB_USER=<DB_USER>

# Database user password
DB_PASSWORD=<DB_PASSWORD>
