# Required

# The system user ID under which Grafana will run — run `id -u` to get the current user's ID
UID=<UID>

# The system group ID under which Grafana will run — run `id -g` to get the current user's group ID
GID=<GID>

# The URL at which Grafana is accessible, without protocol (e.g. grafana.example.com)
SERVICE_URL=<SERVICE_URL>