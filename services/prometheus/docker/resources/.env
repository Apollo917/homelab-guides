# Required

# The system user ID under which Prometheus will run — run `id -u` to get the current user's ID
UID=<UID>

# The system group ID under which Prometheus will run — run `id -g` to get the current user's group ID
GID=<GID>

# The base domain name (e.g. example.com) — Prometheus will be accessible at prometheus.<DOMAIN_NAME>
DOMAIN_NAME=<DOMAIN_NAME>

# Optional

# How long Prometheus retains time series data (e.g. 15d)
TSDB_RETENTION_TIME=