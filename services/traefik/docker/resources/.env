# Required

# The base domain name (e.g. example.com) — used to route traffic and issue TLS certificates for services under
# this domain. Traefik will be accessible at traefik.<DOMAIN_NAME>
DOMAIN_NAME=<DOMAIN_NAME>

# Cloudflare API token used by Traefik to complete the DNS-01 ACME challenge for TLS certificate issuance
CF_DNS_API_TOKEN=<CF_DNS_API_TOKEN>